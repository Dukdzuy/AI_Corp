@startuml
!include _style.iuml
skinparam ranksep 30
rectangle "BA" as BA
rectangle "Architect" as AR
rectangle "DEV" as DV
rectangle "QC" as QC
rectangle "QA" as QA
file "docs/use-cases.md" as F1
file "domain-model.puml\nclass-diagram.puml\nsequence-UC-xxx.puml\narchitecture-patterns.md" as F2
file "src/domain, src/application,\nsrc/infrastructure, src/presentation,\ncomposition-root.ts" as F3
file "docs/code-quality.md" as F4
file "tests/UC-xxx.spec.ts\ndocs/traceability-matrix.md" as F5
rectangle "Kiểm tra 1: cổng OOAD" as K1 #FFF3E0
rectangle "Kiểm tra 2: phân tích tĩnh,\nluật phân lớp" as K2 #FFF3E0
rectangle "Kiểm tra 3: kiểm thử chấp nhận\nđã chạy và đạt" as K3 #FFF3E0
BA --> F1
F1 --> AR
AR --> F2
AR --> F3
F2 --> K1
K1 --> DV : đạt
K1 ..> AR : không đạt
DV --> F3 : điền mã
F3 --> K2
K2 --> F4
F4 --> QC
QC --> F5
F5 --> K3
K3 --> QA
QA ..> DV : FAIL
@enduml
